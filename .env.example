# Copia este archivo a .env y ajusta los valores. NUNCA subas .env a GitHub.

# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# En local sin HTTPS pon False; en el servidor real, True.
DJANGO_SECURE_SSL_REDIRECT=False

# Base de datos
POSTGRES_DB=puntos
POSTGRES_USER=puntos
POSTGRES_PASSWORD=puntos

# Reglas de negocio
VENTANA_VALIDEZ_HORAS=3
REPUTACION_CONFIANZA=20

# IA (opcional, fase 2). Sin clave usa el extractor por reglas.
IA_HABILITADA=False
IA_API_KEY=
IA_MODELO=claude-haiku-5-5

# Si cambias PUERTO_WEB, cambia también el puerto aquí
PUERTO_WEB=8080
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
